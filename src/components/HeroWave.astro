---
/**
 * HeroWave - Dynamic domain-warping canvas backdrop for hero sections.
 *
 * Port of a React component (https://21st.dev/community/components/thanh/
 * dynamic-wave-canvas-background) to vanilla JS so it fits our 0-React,
 * 0-bundle-JS stack. The algorithm is unchanged (4-iter domain warping
 * with fastSin/fastCos lookup tables) but the color output is remapped
 * to Arkivest monochrome (ink/paper) - no blue, no purple, no AI gradient.
 *
 * Perf guards layered on top of the original:
 *   1. SCALE=3 (was 2) - render at 1/3 res, upscale via drawImage nearest.
 *      ~9x fewer pixels iterated per frame.
 *   2. IntersectionObserver pause - rAF loop only runs when canvas in
 *      viewport. Scrolling past the hero stops CPU entirely.
 *   3. prefers-reduced-motion - renders ONE static frame at t=0 then
 *      freezes. No animation, no battery drain.
 *   4. Single-channel intensity (1 multiplication vs 3 in original) -
 *      monochrome means we compute one value then write to R=G=B.
 *
 * Visible behaviour: subtle ink veining on near-paper background.
 * Intensity range capped at 0.35 mix-toward-ink so headline above
 * (z-10) stays readable. Top-right radial mask (matches old aurora
 * placement) fades the field into pure paper at edges.
 */
---

<canvas
  data-hero-wave
  aria-hidden="true"
  class="absolute inset-0 h-full w-full"
></canvas>

<style>
  canvas[data-hero-wave] {
    /* Mask field centered in hero with soft falloff. Top edge MUST fade
       to pure transparent so header (paper bg above) blends seamlessly
       into the hero section - no visible band at the transition. Bottom
       also fades so the headline rotator sits clean and content below
       starts on plain paper. */
    -webkit-mask-image: radial-gradient(
      ellipse 70% 42% at 50% 50%,
      #000 0%,
      rgba(0, 0, 0, 0.85) 30%,
      transparent 88%
    );
    mask-image: radial-gradient(
      ellipse 70% 42% at 50% 50%,
      #000 0%,
      rgba(0, 0, 0, 0.85) 30%,
      transparent 88%
    );
    pointer-events: none;
    /* Lower opacity - the wave is ambient texture sitting under the
       headline, not the foreground. Combined with mask, edges feather
       to pure paper for seamless join with header above. */
    opacity: 0.75;
  }
</style>

<script>
  // ── Arkivest palette (matches @theme tokens in global.css) ────────────
  // paper #FDFDFD -> ink #191818. Wave intensity 0..1 controls mix factor.
  const PAPER_R = 253, PAPER_G = 253, PAPER_B = 253;
  const INK_R   = 25,  INK_G   = 24,  INK_B   = 24;
  const MIX_MAX = 0.35; // cap how dark the wave gets - keeps headline readable

  // ── Lookup tables (build once, reuse forever) ─────────────────────────
  const TABLE_SIZE = 1024;
  const TABLE_MASK = TABLE_SIZE - 1;
  const SIN_TABLE = new Float32Array(TABLE_SIZE);
  const COS_TABLE = new Float32Array(TABLE_SIZE);
  const TWO_PI = Math.PI * 2;
  for (let i = 0; i < TABLE_SIZE; i++) {
    const angle = (i / TABLE_SIZE) * TWO_PI;
    SIN_TABLE[i] = Math.sin(angle);
    COS_TABLE[i] = Math.cos(angle);
  }
  const TABLE_SCALE = TABLE_SIZE / TWO_PI;
  const fastSin = (x: number) => SIN_TABLE[((x * TABLE_SCALE) | 0) & TABLE_MASK];
  const fastCos = (x: number) => COS_TABLE[((x * TABLE_SCALE) | 0) & TABLE_MASK];

  const SCALE = 3; // render at 1/3 res, upscale - ~9x fewer pixels than SCALE=1

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLCanvasElement>("canvas[data-hero-wave]").forEach((canvas) => {
    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;

    let lowW = 0, lowH = 0;
    let imageData: ImageData | null = null;
    let data: Uint8ClampedArray | null = null;
    let lowCanvas: HTMLCanvasElement | null = null;
    let lowCtx: CanvasRenderingContext2D | null = null;

    const resize = () => {
      const dispW = canvas.clientWidth || window.innerWidth;
      const dispH = canvas.clientHeight || window.innerHeight;
      canvas.width = dispW;
      canvas.height = dispH;
      lowW = Math.max(1, Math.floor(dispW / SCALE));
      lowH = Math.max(1, Math.floor(dispH / SCALE));
      // Offscreen low-res buffer holds the raw imageData we draw into,
      // then we upscale-blit to the visible canvas. Keeps putImageData fast.
      lowCanvas = document.createElement("canvas");
      lowCanvas.width = lowW;
      lowCanvas.height = lowH;
      lowCtx = lowCanvas.getContext("2d");
      if (!lowCtx) return;
      imageData = lowCtx.createImageData(lowW, lowH);
      data = imageData.data;
      ctx.imageSmoothingEnabled = false;
    };
    resize();
    window.addEventListener("resize", resize, { passive: true });

    const startTime = performance.now();
    let visible = true;
    let rafId = 0;

    const drawFrame = (timeMs: number) => {
      if (!data || !imageData || !lowCtx || !lowCanvas) return;
      const t = (timeMs - startTime) * 0.001;
      const w = lowW, h = lowH;
      const invH = 1 / h;

      for (let y = 0; y < h; y++) {
        const u_y = (2 * y - h) * invH;
        for (let x = 0; x < w; x++) {
          const u_x = (2 * x - w) * invH;

          let a = 0, d = 0;
          for (let i = 0; i < 4; i++) {
            a += fastCos(i - d + t * 0.5 - a * u_x);
            d += fastSin(i * u_y + a);
          }

          // Wave value in [-1..1], normalise to [0..1]
          const wave = (fastSin(a) + fastCos(d)) * 0.5;
          const mix = Math.max(0, Math.min(1, 0.5 + 0.5 * wave)) * MIX_MAX;

          // Lerp paper -> ink. Single channel math, then write RGB equal.
          const r = PAPER_R + (INK_R - PAPER_R) * mix;
          const g = PAPER_G + (INK_G - PAPER_G) * mix;
          const b = PAPER_B + (INK_B - PAPER_B) * mix;

          const idx = (y * w + x) * 4;
          data[idx]     = r;
          data[idx + 1] = g;
          data[idx + 2] = b;
          data[idx + 3] = 255;
        }
      }

      lowCtx.putImageData(imageData, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(lowCanvas, 0, 0, canvas.width, canvas.height);
    };

    // ── Animation loop ───────────────────────────────────────────────
    if (reducedMotion) {
      // Static frame only - no rAF loop, no battery drain.
      drawFrame(startTime);
    } else {
      const loop = (ts: number) => {
        if (visible) drawFrame(ts);
        rafId = requestAnimationFrame(loop);
      };
      rafId = requestAnimationFrame(loop);

      // Pause CPU when hero scrolled out of view.
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { visible = e.isIntersecting; }),
          { threshold: 0 }
        );
        io.observe(canvas);
      }
    }

    // Cleanup on view transition (Astro ViewTransitions) - defensive,
    // safe no-op if VT not enabled.
    document.addEventListener("astro:before-swap", () => {
      cancelAnimationFrame(rafId);
    }, { once: true });
  });
</script>
