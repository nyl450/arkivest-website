---
interface Props {
  lang?: "id" | "en";
}
const { lang = "id" } = Astro.props;

const isEN = lang === "en";
const prefix = isEN ? "/en" : "";

const nav = isEN
  ? [
      { href: `${prefix}/work`, label: "Work" },
      { href: `${prefix}/services`, label: "Services" },
      { href: `${prefix}/contact`, label: "Contact" },
    ]
  : [
      { href: "/work", label: "Karya" },
      { href: "/services", label: "Layanan" },
      { href: "/contact", label: "Kontak" },
    ];

const homeHref = isEN ? "/en" : "/";
const switchHref = isEN
  ? Astro.url.pathname.replace(/^\/en/, "") || "/"
  : `/en${Astro.url.pathname === "/" ? "" : Astro.url.pathname}`;
const switchLabel = isEN ? "ID" : "EN";
const ctaLabel = isEN ? "Get in touch" : "Hubungi";
---

{/* Sticky band - transparent. Inner contains 3-segment pill setup. */}
<header
  class="sticky top-0 z-50 w-full transition-shadow"
  id="site-header"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 pb-3 pt-4 lg:px-6"
  >
    {/* Segment 1: Logo (left, own pill for visual weight balance) */}
    <a
      href={homeHref}
      class="group flex items-center rounded-full border border-ink/10 bg-paper/80 px-4 py-2 backdrop-blur-md transition hover:bg-paper"
      aria-label="Arkivest home"
    >
      <img
        src="/brand/logo-light.svg"
        alt="Arkivest"
        width="96"
        height="26"
        class="h-6 w-auto"
      />
    </a>

    {/* Segment 2: Nav pill (center, hidden on mobile) */}
    <nav
      class="hidden items-center gap-1 rounded-full border border-ink/10 bg-paper/80 px-2 py-1.5 backdrop-blur-md md:flex"
      aria-label="Primary"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-full px-4 py-2 text-body-sm font-medium text-ink/75 transition hover:bg-ink/5 hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    {/* Segment 3: Actions (right - lang switch + CTA) */}
    <div class="flex items-center gap-2">
      <a
        href={switchHref}
        class="hidden h-10 w-10 items-center justify-center rounded-full border border-ink/10 bg-paper/80 font-mono text-caption text-ink/70 backdrop-blur-md transition hover:bg-paper hover:text-ink sm:inline-flex"
        aria-label={`Switch to ${switchLabel}`}
      >
        {switchLabel}
      </a>
      <a
        href={`${prefix}/contact`}
        class="group inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-body-sm font-medium text-paper transition hover:bg-signal"
      >
        <span class="hidden sm:inline">{ctaLabel}</span>
        <span class="sm:hidden">{isEN ? "Contact" : "Kontak"}</span>
        <span
          class="inline-block transition-transform duration-300 group-hover:translate-x-0.5"
          aria-hidden="true"
        >→</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Optional: scroll past hero -> nav pill shadow lifts (subtle depth cue).
  const header = document.getElementById("site-header");
  if (header) {
    const setShadow = () => {
      if (window.scrollY > 16) {
        header.classList.add("scrolled");
      } else {
        header.classList.remove("scrolled");
      }
    };
    setShadow();
    window.addEventListener("scroll", setShadow, { passive: true });
  }
</script>

<style>
  #site-header.scrolled > div > a:first-child,
  #site-header.scrolled > div > nav,
  #site-header.scrolled > div > div > a:first-child {
    box-shadow: 0 8px 24px -16px rgba(25, 24, 24, 0.25);
  }
</style>
