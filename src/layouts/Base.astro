---
import "../styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

interface Props {
  title: string;
  description: string;
  lang?: "id" | "en";
  pathname?: string;
  ogImage?: string;
}

const {
  title,
  description,
  lang = "id",
  pathname = Astro.url.pathname,
  ogImage = "/og-default.png",
} = Astro.props;

const SITE = "https://arkivest.id";
const canonical = new URL(pathname, SITE).toString();

// Build hreflang pair (id <-> en, x-default points to id)
const isEN = pathname.startsWith("/en");
const idPath = isEN ? pathname.replace(/^\/en/, "") || "/" : pathname;
const enPath = isEN ? pathname : `/en${pathname === "/" ? "" : pathname}`;
const altID = new URL(idPath, SITE).toString();
const altEN = new URL(enPath, SITE).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="id" href={altID} />
    <link rel="alternate" hreflang="en" href={altEN} />
    <link rel="alternate" hreflang="x-default" href={altID} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, SITE).toString()} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "id_ID"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, SITE).toString()} />

    <link rel="icon" type="image/svg+xml" href="/brand/logo-light.svg" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "Arkivest",
        url: SITE,
        logo: `${SITE}/brand/logo-light.svg`,
        description:
          "Web studio Indonesia. Bangun website siap konversi untuk UKM yang serius. Stack modern, security dipraktikkan, SEO terukur.",
      })}
    />

    {/* Per-page head injection (extra structured data, preloads, etc.) */}
    <slot name="head" />
  </head>
  <body class="bg-paper text-ink antialiased">
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Scroll reveal: IntersectionObserver toggles .is-visible.
      // ~600 bytes, GPU-accelerated (transform + opacity only).
      const els = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        // No-IO fallback: show everything immediately.
        els.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
