---
import Base from "@layouts/Base.astro";
import FloatingTools from "@components/FloatingTools.astro";

const title = "Arkivest - Web studio yang serius untuk usaha yang siap scale";
const description =
  "Studio web untuk usaha yang siap scale online. Custom build, security dipraktikkan, SEO terukur. Bukti karya: Wearscrubs. Mulai Rp 5 juta.";

const words = ["Sistem Bisnis", "Web Modern", "E-commerce", "Dashboard Admin", "Brand Digital"];

const pilars = [
  {
    no: "01",
    label: "Security",
    title: "Dipraktikkan, bukan dipajang.",
    body: "Row-Level Security, JWT + bcrypt, rate limiter login, bucket privat dengan signed URL, anti-tamper harga server-side. Standar Wearscrubs, standar setiap project Arkivest.",
  },
  {
    no: "02",
    label: "SEO",
    title: "Terukur sampai meta description.",
    body: "Title unik, structured data, hreflang ID-EN, sitemap auto, OG image berbranding. Bukan checklist plugin. Setiap halaman dibuat untuk dapat traffic.",
  },
  {
    no: "03",
    label: "Logic",
    title: "Kode yang dipikirkan.",
    body: "Transaksi atomik, validasi server-side, alur bisnis yang dimodelkan sesuai realita. Kalau admin Anda istri yang sibuk anak, dashboard harus bisa dipakai tanpa training.",
  },
];

// 8 karya - Cuberto-style with brand-color placeholders.
// bg: honest brand-vibe guess per project (Wearscrubs is real, others are educated guesses).
// Swap with real screenshot via /public/work/{slug}.webp later.
const projects = [
  {
    slug: "wearscrubs",
    href: "/work/wearscrubs",
    eyebrow: "Arkivest case · Live",
    title: "Wearscrubs",
    subtitle: "Toko scrubs dokter dgn dashboard intuitif untuk admin non-teknis.",
    domain: "wearscrubs.id",
    bg: "#1c1c1c",
    monoColor: "rgba(255,255,255,0.08)",
  },
  {
    slug: "mitra-niaga",
    href: "/work",
    eyebrow: "Freelance · 2024",
    title: "PT Mitra Niaga Madani",
    subtitle: "Profil + product showcase distributor.",
    domain: "mitraniaga.id",
    bg: "#2D4A3E",
    monoColor: "rgba(255,255,255,0.1)",
  },
  {
    slug: "salon-andoyun",
    href: "/work",
    eyebrow: "Freelance · 2024",
    title: "Salon Ando & Yun",
    subtitle: "Booking + service catalog untuk salon premium.",
    domain: "salonandoyun.com",
    bg: "#B89492",
    monoColor: "rgba(255,255,255,0.18)",
  },
  {
    slug: "la-demoiselle",
    href: "/work",
    eyebrow: "Freelance · 2024",
    title: "La Demoiselle",
    subtitle: "Editorial brand site untuk lini wedding & lifestyle.",
    domain: "lademoiselle.id",
    bg: "#D8C4A8",
    monoColor: "rgba(25,24,24,0.08)",
  },
  {
    slug: "dcimage",
    href: "/work",
    eyebrow: "Lead Dev di PT DCI · 2023",
    title: "Digital Communication Image",
    subtitle: "Redesign corporate + CMS internal.",
    domain: "dcimage.id",
    bg: "#C5572D",
    monoColor: "rgba(255,255,255,0.12)",
  },
  {
    slug: "arthavest",
    href: "/work",
    eyebrow: "PT Arthavest TBK · 2021",
    title: "Arthavest TBK",
    subtitle: "Investor relations + listing real estate.",
    domain: "arthavest.com",
    bg: "#2B3654",
    monoColor: "rgba(255,255,255,0.1)",
  },
  {
    slug: "digisign",
    href: "/work",
    eyebrow: "PT Solusi Net · 2019",
    title: "Digisign",
    subtitle: "Marketing site untuk SaaS e-signature.",
    domain: "digisign.id",
    bg: "#4A6B85",
    monoColor: "rgba(255,255,255,0.12)",
  },
  {
    slug: "griya-gadai",
    href: "/work",
    eyebrow: "PT Griya Gadai · 2018",
    title: "Griya Gadai Indonesia",
    subtitle: "Multi-branch pegadaian + locator + simulasi.",
    domain: "griya-gadai.co.id",
    bg: "#6B2E2A",
    monoColor: "rgba(255,255,255,0.12)",
  },
