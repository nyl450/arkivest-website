// 3 capability services (Option C: no pricing on homepage)
const services = [
  {
    no: "01",
    title: "Sistem & E-commerce",
    desc: "Toko online, dashboard admin, inventory, payment, ongkir. Custom logic untuk alur bisnis yang tidak template.",
    bullets: [
      "Multi-role admin + audit trail",
      "Payment gateway + checkout custom",
      "Stock management + PO/custom flow",
      "WhatsApp integration",
    ],
    tone: "dark",
  },
  {
    no: "02",
    title: "Web Editorial & Brand",
    desc: "Marketing site, corporate profile, portfolio. Premium feel, performance budget ketat, SEO matang sejak hari pertama.",
    bullets: [
      "Bilingual ID-EN sejak start",
      "Structured data + hreflang",
      "LCP <2.5s, JS <80KB gz",
      "OG image + schema lengkap",
    ],
    tone: "light",
  },
  {
    no: "03",
    title: "Dashboard & Sistem Custom",
    desc: "Admin panel intuitif untuk non-teknis, CRM ringan, broadcast tools, sistem internal. Built untuk dipakai, bukan dipajang.",
    bullets: [
      "Role-based access control",
      "Audit log + history tracking",
      "Reporting + export",
      "API-ready untuk integrasi",
    ],
    tone: "light",
  },
];
---

<Base title={title} description={description} lang="id">
  {/* ============ HERO ============ */}
  <section class="relative overflow-hidden pt-20 pb-12 lg:pt-28 lg:pb-20">
    <div class="aurora-bg" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto w-full max-w-7xl px-6 lg:px-10">
      <h1
        class="mx-auto max-w-4xl text-center text-[clamp(2.5rem,8.5vw,6.5rem)] font-semibold leading-[1.02] tracking-[-0.03em]"
      >
        <span class="block text-ink/90">Kami membangun</span>
        <span class="rotator relative mt-2 inline-block italic text-ink/65">
          <span class="rotator-sizer">Dashboard Admin</span>
          {
            words.map((w, i) => (
              <span class:list={["word", i === 0 && "is-active"]}>{w}</span>
            ))
          }
        </span>
      </h1>

      <p
        class="mx-auto mt-10 max-w-5xl text-balance text-center text-h4 leading-[1.45] text-ink/70 lg:text-[1.5rem]"
      >
        Kami membantu perusahaan mengembangkan produk digital yang dapat
        diskalakan dengan sistem desain yang matang dan proses pengembangan
        yang dirancang secara cermat.
      </p>
    </div>
  </section>

  {/* ============ HERO IMAGE ============ */}
  <section class="pb-16 lg:pb-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <div
        class="reveal relative aspect-[21/9] overflow-hidden rounded-[2rem] bg-ink shadow-[0_40px_80px_-40px_rgba(25,24,24,0.4)] lg:rounded-[2.5rem]"
      >
        <img
          src="/brand/hero.png"
          alt="Arkivest studio hero"
          width="2520"
          height="1080"
          class="absolute inset-0 h-full w-full object-cover drift"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  {/* ============ PENDEKATAN (FloatingTools) ============ */}
  <FloatingTools lang="id" />

  {/* ============ MID-PAGE LUMIO TEXT MOMENT ============
       3 draft options (ARK propose, James pick):

       Option 1 (Philosophy - manifesto):
         "Setiap kode harus punya alasan untuk ada."
         sub: "Bukan tagline. Itu cara kami memutuskan apa yang masuk
               dan apa yang tidak ke project Anda."

       Option 2 (Mission - benefit-led, ACTIVE):
         "Bisnis yang serius layak punya platform yang sama seriusnya."
         sub: "Kami bangun sistem yang akan bertahan, scale, dan tetap
               masuk akal dipakai admin Anda."

       Option 3 (Contrarian - distinctive):
         "Template hari ini, regret tahun depan."
         sub: "Kami bangun fondasi yang tidak harus dilempar saat
               bisnis Anda tumbuh."
       =================================================== */}
  <section class="py-32 lg:py-48">
    <div class="mx-auto max-w-4xl px-6 text-center lg:px-10">
      <p
        class="reveal text-balance text-[clamp(2rem,5vw,3.75rem)] font-semibold leading-[1.1] tracking-[-0.025em]"
      >
        Bisnis yang serius layak punya platform yang sama seriusnya.
      </p>
      <p
        class="reveal reveal-delay-1 mx-auto mt-8 max-w-2xl text-balance text-body-lg leading-[1.55] text-ink/60"
      >
        Kami bangun sistem yang akan bertahan, scale, dan tetap masuk akal
        dipakai admin Anda.
      </p>
    </div>
  </section>

  {/* ============ KARYA (Cuberto-style, 2-col grid, dark, rounded-top) ============ */}
  <section
    id="work"
    class="relative rounded-t-[3rem] bg-ink pb-24 pt-20 text-paper lg:rounded-t-[4rem] lg:pb-32 lg:pt-28"
  >
    <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
      <div class="reveal flex flex-wrap items-end justify-between gap-6 pb-12 lg:pb-16">
        <div>
          <p
            class="font-mono text-caption uppercase tracking-[0.18em] text-paper/55"
          >
            Karya · {projects.length} project
          </p>
          <h2
            class="mt-4 text-[clamp(2.5rem,6vw,5rem)] font-semibold tracking-tight"
          >
            Featured projects.
          </h2>
        </div>
        <p class="max-w-md text-body text-paper/60">
          Dari toko scrubs dokter sampai sistem investor relations. Kami bangun
          sistem yang dipakai admin nyata, bukan demo board.
        </p>
      </div>

      <div class="grid gap-x-8 gap-y-16 md:grid-cols-2 lg:gap-x-10 lg:gap-y-20">
        {
          projects.map((p, i) => (
            <a href={p.href} class:list={["reveal group block", i % 2 === 1 && "md:mt-16 lg:mt-28"]}>
              <div
                class="relative aspect-[4/5] overflow-hidden rounded-3xl p-8 transition duration-500 group-hover:scale-[1.01] lg:rounded-[2rem] lg:p-10"
                style={`background-color: ${p.bg}`}
              >
                <div class="flex h-full flex-col justify-between">
                  <div class="flex items-start justify-between gap-4">
                    <p class="font-mono text-caption uppercase tracking-[0.18em] text-paper/50">
                      {p.eyebrow}
                    </p>
                    <span class="font-mono text-caption uppercase tracking-widest text-paper/55">
                      ↗
                    </span>
                  </div>
                  <div class="relative">
                    <span
                      class="select-none text-[clamp(7rem,22vw,16rem)] font-bold leading-[0.85] tracking-tighter"
                      style={`color: ${p.monoColor}`}
                    >
                      {p.title.charAt(0)}
                    </span>
                  </div>
                </div>
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent opacity-0 transition duration-700 group-hover:opacity-100" />
              </div>
              <div class="mt-6 flex items-start justify-between gap-6">
                <div>
                  <h3 class="text-h4 font-semibold tracking-tight text-paper lg:text-h3">
                    {p.title}
                  </h3>
                  <p class="mt-2 max-w-md text-body-sm text-paper/60">
                    {p.subtitle}
                  </p>
                </div>
                <span class="shrink-0 font-mono text-caption text-paper/55">
                  {p.domain}
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ============ OUR SERVICES (capability-only, rounded-top emerges from karya dark) ============ */}
  <section
    class="relative -mt-12 rounded-t-[3rem] bg-paper pb-24 pt-24 lg:-mt-16 lg:rounded-t-[4rem] lg:pb-32 lg:pt-32"
  >
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <div class="reveal grid gap-12 lg:grid-cols-[2fr_1fr] lg:items-end">
        <h2
          class="text-[clamp(3rem,8vw,7rem)] font-semibold leading-[0.95] tracking-[-0.03em]"
        >
          Our<br />services
        </h2>
        <p class="max-w-md text-body-lg text-ink/65">
          Dari sistem e-commerce sampai dashboard admin custom. Kami bangun
          produk digital yang dipakai, bukan dipajang.
        </p>
      </div>

      <div class="mt-20 grid gap-6 md:grid-cols-2 lg:mt-28 lg:gap-8">
        {
          services.map((s, i) => {
            const isDark = s.tone === "dark";
            const colSpan = i === 0 ? "md:col-span-2" : "";
            return (
              <article
                class:list={[
                  "reveal relative overflow-hidden rounded-3xl p-10 lg:rounded-[2rem] lg:p-12",
                  isDark
                    ? "bg-ink text-paper"
                    : "border border-ink/8 bg-paper-2 text-ink",
                  colSpan,
                ]}
              >
                <p
                  class:list={[
                    "font-mono text-caption uppercase tracking-[0.18em]",
                    isDark ? "text-paper/55" : "text-ink/70",
                  ]}
                >
                  {s.no} / Layanan
                </p>
                <h3
                  class="mt-6 text-[clamp(1.75rem,3.5vw,2.75rem)] font-semibold leading-[1.1] tracking-tight"
                >
                  {s.title}
                </h3>
                <p
                  class:list={[
                    "mt-5 max-w-xl text-body-lg",
                    isDark ? "text-paper/70" : "text-ink/65",
                  ]}
                >
                  {s.desc}
                </p>
                <ul
                  class:list={[
                    "mt-8 grid gap-3 border-t pt-6 text-body-sm font-medium md:grid-cols-2",
                    isDark
                      ? "border-paper/10 text-paper/80"
                      : "border-ink/10 text-ink/75",
                  ]}
                >
                  {
                    s.bullets.map((b) => (
                      <li class="flex items-start gap-2">
                        <span
                          class:list={[
                            "mt-2 inline-block h-1 w-1 shrink-0 rounded-full",
                            isDark ? "bg-paper/50" : "bg-ink/70",
                          ]}
                        />
                        {b}
                      </li>
                    ))
                  }
                </ul>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* ============ PILARS ============ */}
  <section class="py-20 lg:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <div class="reveal grid gap-10 md:grid-cols-[1fr_2fr]">
        <p
          class="font-mono text-caption uppercase tracking-[0.18em] text-muted"
        >
          Tiga pilar
        </p>
        <h2 class="max-w-3xl text-h2 font-semibold tracking-tight lg:text-h1">
          Tiga hal yang tidak boleh kompromi.
        </h2>
      </div>

      <div class="mt-20 space-y-20 lg:space-y-32">
        {
          pilars.map((p) => (
            <article class="reveal grid gap-8 border-t border-ink/10 pt-12 md:grid-cols-12 lg:pt-16">
              <div class="md:col-span-3">
                <p class="font-mono text-caption text-ink/70">
                  {p.no} / {p.label}
                </p>
              </div>
              <div class="md:col-span-9">
                <h3 class="max-w-3xl text-h2 font-semibold tracking-tight lg:text-[clamp(2rem,4vw,3.25rem)] lg:leading-[1.1]">
                  {p.title}
                </h3>
                <p class="mt-6 max-w-2xl text-body-lg text-ink/70">{p.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ============ CTA ============ */}
  <section>
    <div class="mx-auto max-w-5xl px-6 lg:px-10">
      <div
        class="reveal relative overflow-hidden rounded-[2.5rem] border border-ink/10 p-12 lg:p-20"
      >
        <p
          class="font-mono text-caption uppercase tracking-[0.18em] text-muted"
        >
          Mulai
        </p>
        <h2
          class="mt-6 max-w-3xl text-[clamp(2rem,5.5vw,4.5rem)] font-semibold leading-[1.02] tracking-[-0.02em]"
        >
          Punya produk, butuh website yang serius?
        </h2>
        <p class="mt-8 max-w-xl text-body-lg text-ink/70">
          Mulai Rp 5 juta. Timeline jelas. Kode jadi milik Anda. Maintenance
          opsional.
        </p>
        <div class="mt-12 flex flex-wrap items-center gap-3">
          <a
            href="/contact"
            class="group inline-flex items-center gap-3 rounded-2xl bg-ink px-8 py-4 text-body font-medium text-paper transition hover:bg-ink/85"
          >
            Diskusi project
            <span
              class="inline-block transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true">→</span
            >
          </a>
          <a
            href="https://wa.me/6287887172220?text=Halo%20Arkivest%2C%20saya%20ingin%20diskusi%20project"
            class="rounded-full border border-ink/15 px-8 py-4 text-body font-medium text-ink transition hover:border-ink hover:bg-ink/5"
            rel="noopener"
          >
            WhatsApp langsung
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const rotator = document.querySelector<HTMLElement>(".rotator");
  if (
    rotator &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    const words = rotator.querySelectorAll<HTMLElement>(".word");
    let active = 0;
    if (words.length > 1) {
      setInterval(() => {
        words[active].classList.remove("is-active");
        words[active].classList.add("is-prev");
        active = (active + 1) % words.length;
        words.forEach((w, i) => {
          if (i !== active) w.classList.remove("is-active");
        });
        setTimeout(() => {
          words.forEach((w) => w.classList.remove("is-prev"));
          words[active].classList.add("is-active");
        }, 30);
      }, 2200);
    }
  }
</script>

<style>
  .rotator { overflow: hidden; vertical-align: bottom; }
  .rotator-sizer { visibility: hidden; pointer-events: none; display: inline-block; }
  .word {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    transform: translate3d(0, 100%, 0);
    transition:
      opacity 500ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .word.is-active { opacity: 1; transform: translate3d(0, 0, 0); }
  .word.is-prev { opacity: 0; transform: translate3d(0, -100%, 0); }
  @media (prefers-reduced-motion: reduce) { .word { transition: none; } }
</style>
