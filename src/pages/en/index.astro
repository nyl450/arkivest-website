---
import Base from "@layouts/Base.astro";
import FloatingTools from "@components/FloatingTools.astro";
import HeroWave from "@components/HeroWave.astro";
import GooeyText from "@components/GooeyText.astro";

const title = "Arkivest - A serious web studio for businesses ready to scale";
const description =
  "A web studio for businesses ready to scale online. Custom build, security practiced, SEO measured. Proof of work: Wearscrubs. Starts at IDR 5M.";

const words = ["Business Systems", "Modern Web", "E-commerce", "Admin Dashboards", "Digital Brands"];

const pilars = [
  {
    no: "01",
    label: "Security",
    title: "Practiced, not paraded.",
    body: "Row-Level Security, JWT + bcrypt, login rate limiter, private buckets with signed URLs, server-side price tamper guards. The Wearscrubs baseline. The Arkivest baseline.",
  },
  {
    no: "02",
    label: "SEO",
    title: "Measured down to the meta.",
    body: "Unique titles, structured data, ID-EN hreflang, auto sitemaps, branded OG images. Not a plugin checklist. Every page is built to earn traffic.",
  },
  {
    no: "03",
    label: "Logic",
    title: "Code that's thought through.",
    body: "Atomic transactions, server-side validation, business flows modeled on reality. If your admin is your busy spouse, the dashboard has to work without training.",
  },
];

const projects = [
  {
    slug: "wearscrubs",
    href: "/en/work/wearscrubs",
    eyebrow: "Arkivest case · Live",
    title: "Wearscrubs",
    subtitle: "Doctor-scrubs shop with an intuitive admin for non-technical users.",
    domain: "wearscrubs.id",
    bg: "#1c1c1c",
    monoColor: "rgba(255,255,255,0.08)",
  },
  {
    slug: "mitra-niaga",
    href: "/en/work",
    eyebrow: "Freelance · 2024",
    title: "PT Mitra Niaga Madani",
    subtitle: "Corporate profile + product showcase.",
    domain: "mitraniaga.id",
    bg: "#2D4A3E",
    monoColor: "rgba(255,255,255,0.1)",
  },
  {
    slug: "salon-andoyun",
    href: "/en/work",
    eyebrow: "Freelance · 2024",
    title: "Salon Ando & Yun",
    subtitle: "Booking + service catalog for a premium salon.",
    domain: "salonandoyun.com",
    bg: "#B89492",
    monoColor: "rgba(255,255,255,0.18)",
  },
  {
    slug: "la-demoiselle",
    href: "/en/work",
    eyebrow: "Freelance · 2024",
    title: "La Demoiselle",
    subtitle: "Editorial brand site for a wedding & lifestyle line.",
    domain: "lademoiselle.id",
    bg: "#D8C4A8",
    monoColor: "rgba(25,24,24,0.08)",
  },
  {
    slug: "dcimage",
    href: "/en/work",
    eyebrow: "Lead Dev at PT DCI · 2023",
    title: "Digital Communication Image",
    subtitle: "Corporate redesign + internal CMS.",
    domain: "dcimage.id",
    bg: "#C5572D",
    monoColor: "rgba(255,255,255,0.12)",
  },
  {
    slug: "arthavest",
    href: "/en/work",
    eyebrow: "PT Arthavest TBK · 2021",
    title: "Arthavest TBK",
    subtitle: "Investor relations + real-estate listings.",
    domain: "arthavest.com",
    bg: "#2B3654",
    monoColor: "rgba(255,255,255,0.1)",
  },
  {
    slug: "digisign",
    href: "/en/work",
    eyebrow: "PT Solusi Net · 2019",
    title: "Digisign",
    subtitle: "Marketing site for an e-signature SaaS.",
    domain: "digisign.id",
    bg: "#4A6B85",
    monoColor: "rgba(255,255,255,0.12)",
  },
  {
    slug: "griya-gadai",
    href: "/en/work",
    eyebrow: "PT Griya Gadai · 2018",
    title: "Griya Gadai Indonesia",
    subtitle: "Multi-branch pawnshop with locator + simulator.",
    domain: "griya-gadai.co.id",
    bg: "#6B2E2A",
    monoColor: "rgba(255,255,255,0.12)",
  },
];

const services = [
  {
    no: "01",
    title: "Systems & E-commerce",
    desc: "Online stores, admin dashboards, inventory, payment, shipping. Custom logic for business flows that aren't templates.",
    bullets: [
      "Multi-role admin + audit trail",
      "Payment gateway + custom checkout",
      "Stock management + PO/custom flow",
      "WhatsApp integration",
    ],
    tone: "dark",
  },
  {
    no: "02",
    title: "Editorial Web & Brand",
    desc: "Marketing sites, corporate profiles, portfolios. Premium feel, tight performance budget, mature SEO from day one.",
    bullets: [
      "Bilingual ID-EN from start",
      "Structured data + hreflang",
      "LCP <2.5s, JS <80KB gz",
      "OG image + complete schema",
    ],
    tone: "light",
  },
  {
    no: "03",
    title: "Dashboards & Custom Systems",
    desc: "Intuitive admin panels for non-technical teams, light CRM, broadcast tools, internal systems. Built to be used, not displayed.",
    bullets: [
      "Role-based access control",
      "Audit log + history tracking",
      "Reporting + export",
      "API-ready for integrations",
    ],
    tone: "light",
  },
